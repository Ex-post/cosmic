# Cosmic Ice Cream · Apache / Hostinger / cPanel
# (On Vercel or Netlify use their "Force HTTPS" toggle and _headers file instead.)

# --- Enforce HTTPS + remove www ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cosmicicecream.in%{REQUEST_URI} [L,R=301]

# --- Clean URLs ---
RewriteRule ^how-we-make-it/?$ /how-we-make-it.html [L]
RewriteRule ^privacy/?$ /privacy.html [L]
RewriteRule ^terms/?$ /terms.html [L]

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Speed: compression + caching ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Never serve secrets / config files ---
<FilesMatch "(^\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|\.log)$">
  Require all denied
</FilesMatch>
